{
  "manifest_version": 3,
  "name": "Stabilo",
  "version": "0.1.3",
  "description": "Highlight a passage, add a simple note, and keep reading. Temporary, local, and distraction-free.",
  "minimum_chrome_version": "105",
  "action": {
    "default_title": "Stabilo",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle"
    }
  ]
}
